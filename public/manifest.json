{
  "manifest_version": 3,
  "name": "日历",
  "version": "2.0.1",
  "description": "谷歌浏览器日历插件",
  "icons": {
    "16": "images/icon16.png",
    "48": "images/icon48.png",
    "128": "images/icon128.png"
  },
  "action": {
    "default_popup": "index.html",
    "default_title": "日历"
  },
  "permissions": ["storage"]
}
